    classDef planned fill:#FFE4B5,stroke:#FF8C00,stroke-width:2px,color:#000
    classDef critical fill:#FFB6C1,stroke:#DC143C,stroke-width:2px,color:#000
    classDef infrastructure fill:#ADD8E6,stroke:#00008B,stroke-width:2px,color:#000

    class NodeRED,Pi1,Pi2,Pi3,Pi4,UDMSE,Switch,TrueNAS,Laptop operational
    class MQTT,PostgreSQL,Grafana,Pi5,Pi6 planned
    class Pi4 critical
    class CloudKey,U6Pro,iDRAC,DR7 infrastructure

