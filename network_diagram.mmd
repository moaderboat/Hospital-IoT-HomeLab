    Pi1 -.->|"MQTT Publish<br/>(Planned)"| MQTT
    Pi2 -.->|"MQTT Publish<br/>(Planned)"| MQTT
    Pi3 -.->|"MQTT Publish<br/>(Planned)"| MQTT
    Pi4 -.->|"MQTT Publish<br/>(Planned)"| MQTT

