        "type": "function",
        "z": "balloon_flow",
        "name": "Parse Relay States",
        "func": "return [\n    {payload: msg.payload.pump_running ? 'ON' : 'OFF', topic: 'pump'},\n    {payload: msg.payload.inflate_open ? 'OPEN' : 'CLOSED', topic: 'inflate'},\n    {payload: msg.payload.downstream_open ? 'OPEN' : 'CLOSED', topic: 'downstream'},\n    {payload: msg.payload.upstream_open ? 'OPEN' : 'CLOSED', topic: 'upstream'}\n];",
        "outputs": 4,
        "x": 380,
        "y": 320,
        "wires": [["text_vuln_pump"], ["text_vuln_inflate"], ["text_vuln_downstream"], ["text_vuln_upstream"]]
