        "id": "mqtt_in_vuln_pressure",
        "type": "mqtt in",
        "z": "balloon_flow",
        "name": "Vulnerable Pressure",
        "topic": "balloon/vulnerable/pressure",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker",
        "x": 140,
        "y": 100,
        "wires": [["gauge_vuln_downstream", "chart_vuln_pressure", "parse_vuln_pressure"]]
    },
    {
        "id": "parse_vuln_pressure",
        "type": "function",
        "z": "balloon_flow",
        "name": "Parse Vulnerable Data",
        "func": "msg.payload_downstream = msg.payload.pressure_downstream || 0;\nmsg.payload_upstream = msg.payload.pressure_upstream || 0;\nmsg.payload_source = msg.payload.source || 'unknown';\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 100,
        "wires": [["gauge_vuln_upstream", "text_vuln_source"]]
    },
