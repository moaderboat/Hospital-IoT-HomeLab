[Unit]
Description=Heart Rate Monitor 2 - ECG Display
After=network.target

[Service]
Type=simple
User=username
WorkingDirectory=/home/username
ExecStart=/usr/bin/python3 /home/username/HeartRate2Monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
