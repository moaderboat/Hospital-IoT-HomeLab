            <script>logger.info(&quot;SOURCE TRANSFORMER STARTING&quot;);

  // msg is already a JavaScript object with JSON data type
  // Extract patient ID and format it properly (3 -&gt; &quot;pi-3&quot;)
  var piNumber = msg[&apos;pi_id&apos;];
  var patientId = &quot;pi-&quot; + piNumber;

  logger.info(&quot;Formatted patient ID: &quot; + patientId);

  // Build FHIR R4 Observation resource
  tmp = {};
  tmp[&apos;resourceType&apos;] = &apos;Observation&apos;;
  tmp[&apos;status&apos;] = &apos;final&apos;;
  tmp[&apos;category&apos;] = [{
    &apos;coding&apos;: [{
      &apos;system&apos;: &apos;http://terminology.hl7.org/CodeSystem/observation-category&apos;,
      &apos;code&apos;: &apos;vital-signs&apos;,
      &apos;display&apos;: &apos;Vital Signs&apos;
    }]
  }];
  tmp[&apos;code&apos;] = {
    &apos;coding&apos;: [{
      &apos;system&apos;: &apos;http://loinc.org&apos;,
      &apos;code&apos;: &apos;8867-4&apos;,
      &apos;display&apos;: &apos;Heart rate&apos;
    }],
    &apos;text&apos;: &apos;Heart rate&apos;
  };
  tmp[&apos;subject&apos;] = {
    &apos;reference&apos;: &apos;Patient/&apos; + patientId
  };
  tmp[&apos;effectiveDateTime&apos;] = msg[&apos;timestamp&apos;];
  tmp[&apos;valueQuantity&apos;] = {
    &apos;value&apos;: msg[&apos;bpm&apos;],
    &apos;unit&apos;: &apos;beats/minute&apos;,
    &apos;system&apos;: &apos;http://unitsofmeasure.org&apos;,
    &apos;code&apos;: &apos;/min&apos;
  };

  logger.info(&quot;FHIR Observation created&quot;);

  // Assign to msg
  msg = tmp;</script>
