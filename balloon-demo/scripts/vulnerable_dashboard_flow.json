[
    {
        "id": "vulnerable_tab",
        "type": "tab",
        "label": "Vulnerable Balloon System",
        "disabled": false,
        "info": "Dashboard for Pi #7 Vulnerable Balloon Demo"
    },
    {
        "id": "mqtt_pressure",
        "type": "mqtt in",
        "z": "vulnerable_tab",
        "name": "Pressure Reading",
        "topic": "balloon/vulnerable/pressure",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 120,
        "y": 100,
        "wires": [["pressure_parse", "pressure_gauge"]]
    },
    {
        "id": "mqtt_relays",
        "type": "mqtt in",
        "z": "vulnerable_tab",
        "name": "Relay States",
        "topic": "balloon/vulnerable/relays",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 120,
        "y": 200,
        "wires": [["relay_display"]]
    },
    {
        "id": "mqtt_sensor_source",
        "type": "mqtt in",
        "z": "vulnerable_tab",
        "name": "Sensor Source",
        "topic": "balloon/vulnerable/sensor_source",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 120,
        "y": 300,
        "wires": [["source_display", "attack_check"]]
    },
    {
        "id": "pressure_parse",
        "type": "function",
        "z": "vulnerable_tab",
        "name": "Extract Pressure Value",
        "func": "msg.payload = msg.payload.value;\nreturn msg;",
        "outputs": 1,
        "x": 350,
        "y": 100,
        "wires": [[]]
    },
    {
        "id": "pressure_gauge",
        "type": "ui_gauge",
        "z": "vulnerable_tab",
        "name": "Pressure Gauge",
        "group": "pressure_group",
        "order": 1,
        "width": 6,
        "height": 5,
        "gtype": "gage",
        "title": "Bottle Pressure",
        "label": "PSI",
        "format": "{{value}}",
        "min": 0,
        "max": "15",
        "colors": ["#00b500","#e6e600","#ca3838"],
        "seg1": "2.5",
        "seg2": "3.5",
        "x": 350,
        "y": 150,
        "wires": []
    },
    {
        "id": "relay_display",
        "type": "ui_template",
        "z": "vulnerable_tab",
        "group": "relay_group",
        "name": "Relay Status Display",
        "order": 1,
        "width": 6,
        "height": 4,
        "format": "<div style=\"padding: 10px;\">\n  <div style=\"margin: 5px; padding: 10px; background: {{msg.payload.pump ? '#00b500' : '#555'}}; border-radius: 5px;\">\n    <b>PUMP:</b> {{msg.payload.pump ? 'ON' : 'OFF'}}\n  </div>\n  <div style=\"margin: 5px; padding: 10px; background: {{msg.payload.inflate ? '#00b500' : '#555'}}; border-radius: 5px;\">\n    <b>INFLATE:</b> {{msg.payload.inflate ? 'OPEN' : 'CLOSED'}}\n  </div>\n  <div style=\"margin: 5px; padding: 10px; background: {{msg.payload.vent ? '#e6e600' : '#555'}}; border-radius: 5px;\">\n    <b>VENT:</b> {{msg.payload.vent ? 'OPEN' : 'CLOSED'}}\n  </div>\n  <div style=\"margin: 5px; padding: 10px; background: {{msg.payload.relief ? '#ca3838' : '#555'}}; border-radius: 5px;\">\n    <b>RELIEF:</b> {{msg.payload.relief ? 'OPEN' : 'CLOSED'}}\n  </div>\n</div>",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "templateScope": "local",
        "x": 360,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "source_display",
        "type": "ui_text",
        "z": "vulnerable_tab",
        "group": "status_group",
        "order": 2,
        "width": 6,
        "height": 1,
        "name": "Sensor Source",
        "label": "Data Source:",
        "format": "{{msg.payload.source}} ({{msg.payload.count}} readings)",
        "layout": "row-spread",
        "x": 350,
        "y": 300,
        "wires": []
    },
    {
        "id": "attack_check",
        "type": "function",
        "z": "vulnerable_tab",
        "name": "Check for Attack",
        "func": "if (msg.payload.source === 'attacker') {\n    msg.payload = 'ATTACK DETECTED - SPOOFED SENSOR DATA';\n    msg.background = 'red';\n} else {\n    msg.payload = 'System Normal';\n    msg.background = 'green';\n}\nreturn msg;",
        "outputs": 1,
        "x": 350,
        "y": 350,
        "wires": [["attack_banner"]]
    },
    {
        "id": "attack_banner",
        "type": "ui_text",
        "z": "vulnerable_tab",
        "group": "status_group",
        "order": 1,
        "width": 6,
        "height": 2,
        "name": "Attack Alert",
        "label": "",
        "format": "<div style=\"padding: 15px; background: {{msg.background}}; color: white; font-weight: bold; font-size: 18px; text-align: center; border-radius: 5px;\">\n  {{msg.payload}}\n</div>",
        "layout": "row-spread",
        "x": 550,
        "y": 350,
        "wires": []
    },
    {
        "id": "mqtt_broker",
        "type": "mqtt-broker",
        "name": "Local MQTT Broker",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered_vulnerable_dashboard",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "sessionExpiry": ""
    },
    {
        "id": "pressure_group",
        "type": "ui_group",
        "name": "Pressure Monitor",
        "tab": "main_tab",
        "order": 1,
        "disp": true,
        "width": 6
    },
    {
        "id": "relay_group",
        "type": "ui_group",
        "name": "Relay Status",
        "tab": "main_tab",
        "order": 2,
        "disp": true,
        "width": 6
    },
    {
        "id": "status_group",
        "type": "ui_group",
        "name": "System Status",
        "tab": "main_tab",
        "order": 3,
        "disp": true,
        "width": 6
    },
    {
        "id": "main_tab",
        "type": "ui_tab",
        "name": "Vulnerable Balloon Demo",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    }
]
